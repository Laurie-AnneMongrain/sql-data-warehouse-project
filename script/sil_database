==============================================================================================
DDL Script: Create Silver tables
==============================================================================================
Script Purpose:
	This script Tables in the 'Silver' schema, dropping existing tables if they already exist.
	Run this script to re-define the DDL structure of 'bronze' tables.
==============================================================================================

DROP TABLE IF EXISTS silver.crm_cust_info;

CREATE TABLE silver.crm_cust_info (
    cst_id INT,
    cst_key VARCHAR(50),
    cst_firstname VARCHAR(50),
    cst_lastname VARCHAR(50),
    cst_material_status VARCHAR(50),
    cst_gndr VARCHAR(50),
    cst_create_date DATE,
    dwh_create_date TIMESTAMP default NOW()
);

DROP TABLE IF EXISTS silver.erp_product;

CREATE TABLE silver.erp_product (
    prd_id INT,
    prd_key VARCHAR(50),
    prd_nm VARCHAR(255),
    prd_cost NUMERIC(10,2),
    prd_line VARCHAR(10),
    prd_start_dt DATE,
    prd_end_dt DATE,
    dwh_create_date TIMESTAMP default NOW()
);

DROP TABLE IF EXISTS silver.sales_details;

create table silver.sales_details (
	sls_ord_num VARCHAR(50),
	sls_prd_key VARCHAR(50),
	sls_cust_id INT,
	sls_order_dt DATE,
	sls_ship_dt DATE,
	sls_due_dt DATE,
	sls_sales INT,
	sls_quantity INT,
	sls_price INT,
	dwh_create_date TIMESTAMP default NOW()
	);

DROP TABLE IF EXISTS silver.CUST_AZ12;

create table silver.CUST_AZ12 (
	CID VARCHAR(50),
	BDATE date,
	GEN VARCHAR(50),
	dwh_create_date TIMESTAMP default NOW()
	);

DROP TABLE IF EXISTS silver.LOC_A101;

create table silver.LOC_A101 (
	CID VARCHAR(50),
	CNTRY VARCHAR(50),
	dwh_create_date TIMESTAMP default NOW()
	);

DROP TABLE IF EXISTS silver.PX_CAT_G1V2;

create table silver.PX_CAT_G1V2 (
	ID VARCHAR(50),
	CAT VARCHAR(50),
	SUBCAT VARCHAR(50),
	MAINTENANCE VARCHAR(50),
	dwh_create_date TIMESTAMP default NOW()
	);
